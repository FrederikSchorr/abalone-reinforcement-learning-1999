typedef struct
 {
  int zeile;
  int spalte;
  int inhalt;
 }einabafeld;

typedef struct
 {
  int x;
  int y;
 }coord;

typedef unsigned char byte;

typedef struct
 {
  byte z;
  byte sp;
 }position;

typedef struct
 {
  byte feld[11][11];
  byte outsp[3];
  position pos;             /* 'reserve' um geschw zu erhohen */
  coord a,b,c,d,e,f;
  int seite,radius;
  byte color[5]; 	    /* farben der sp.: 1-sp1,2-sp2,3-prsp1,4-prsp2 */
  void *buffer[5];          /* graphik */
 }abalone;



