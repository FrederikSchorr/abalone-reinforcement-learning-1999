                    ES_READONLY | WS_VSCROLL | NOT WS_TABSTOP
    EDITTEXT        IDC_OUTPUT,7,165,149,13,ES_READONLY | NOT WS_TABSTOP
END

IDD_PLAYERSELECT DIALOG DISCARDABLE  0, 0, 241, 69
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
