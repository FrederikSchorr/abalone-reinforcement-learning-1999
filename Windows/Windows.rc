    LTEXT           "frederik@fsmat.htu.tuwien.ac.at",IDC_STATIC,40,35,119,8
    LTEXT           "Copyright (C) 1999",IDC_STATIC,40,45,119,8
    ICON            IDR_MAINFRAME,IDC_STATIC,14,26,16,16
END

