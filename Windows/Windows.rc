IDD_PLAYERMODIFY DIALOG DISCARDABLE  0, 0, 298, 206
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Modify Player"
FONT 8, "MS Sans Serif"
BEGIN
    EDITTEXT        IDC_INPUT,161,165,130,13,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Continue",IDC_CONTINUE,241,185,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,182,185,50,14
